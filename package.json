{
  "name": "continuum",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "core:build": "node scripts/build-core.mjs",
    "core:test": "cargo test -p muzak-core",
    "predev": "npm run core:build",
    "dev": "vite --host 127.0.0.1",
    "prebuild": "npm run core:build -- --release",
    "build": "tsc --noEmit && vite build",
    "pretest": "npm run core:build",
    "test": "tsx --test tests/*.test.ts",
    "pretest:score": "npm run core:build",
    "test:score": "tsx --test tests/score-*.test.ts",
    "preanalyze": "npm run core:build",
    "analyze": "tsx scripts/analyze-score.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0"
  }
}
